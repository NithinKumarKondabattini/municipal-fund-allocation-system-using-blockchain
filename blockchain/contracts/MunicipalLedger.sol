pragma solidity ^0.8.24;
contract MunicipalLedger { event ProofRecorded(string indexed action,uint256 indexed projectId,uint256 indexed recordId,uint256 amount,string proof,uint256 timestamp); function recordProject(uint256 projectId,string calldata proof) external {emit ProofRecorded('PROJECT',projectId,0,0,proof,block.timestamp);} function recordFundAllocation(uint256 projectId,uint256 id,uint256 amount,string calldata proof) external {emit ProofRecorded('ALLOCATION',projectId,id,amount,proof,block.timestamp);} function recordExpenditure(uint256 projectId,uint256 id,uint256 amount,string calldata proof) external {emit ProofRecorded('EXPENDITURE',projectId,id,amount,proof,block.timestamp);} function recordDocumentHash(uint256 projectId,uint256 id,string calldata hash) external {emit ProofRecorded('DOCUMENT',projectId,id,0,hash,block.timestamp);} function recordAuditEvent(uint256 projectId,uint256 id,string calldata proof) external {emit ProofRecorded('AUDIT',projectId,id,0,proof,block.timestamp);} }
