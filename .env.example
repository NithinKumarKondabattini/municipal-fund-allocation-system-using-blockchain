PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_FILE=./data/municipal.db
AI_SERVICE_URL=http://127.0.0.1:8000
UPLOAD_DIR=./uploads
# Optional Supabase Storage + document metadata mirror. Keep the service role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=municipal-documents
# Set true only after running docs/supabase.sql in Supabase SQL Editor.
SUPABASE_SYNC_DOCUMENTS=false
